# Supabase Configuration (set these in Vercel Project Settings -> Environment Variables)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Application Signing & Legacy Fernet Encryption Keys
SECRET_KEY=
ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
EMAIL_ENCRYPTION_KEY=

# Dropbox Storage (Book Covers, Uploads & Backups)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_COVERS_FOLDER=/Iloilo_Public_Library_Covers
DROPBOX_EVENTS_FOLDER=/Iloilo_Public_Library_Events
DROPBOX_FOLDER=/Iloilo_Public_Library_Backups

# Resend Email API (Password/PIN Reset, OTP & Optional Event Reminders)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
EVENT_REMINDER_EMAILS_ENABLED=false

# Vercel Cron Secret for /api/backup and /api/cron/event-reminders scheduled jobs
CRON_SECRET=
