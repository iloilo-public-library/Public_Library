# Supabase Configuration (set these in Vercel Project Settings -> Environment Variables)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Dropbox Storage (Book Covers, Uploads & Backups)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_COVERS_FOLDER=/Iloilo_Public_Library_Covers
DROPBOX_FOLDER=/Iloilo_Public_Library_Backups

# Resend Email API (Password/PIN Reset & OTP)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Vercel Cron Secret for /api/backup scheduled snapshots
CRON_SECRET=
